# Server environment — copy to server/.env and fill in. Never commit the real .env.

# Core
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# Database (managed Postgres needs ?sslmode=require on the URL in production)
DATABASE_URL=postgresql://postgres:password@localhost:5432/coldpen

# Clerk (auth) — CLERK_WEBHOOK_SECRET is required; the server fails to boot without it
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# Anthropic (AI). Set MOCK_AI=true to skip real API calls in local dev.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
MOCK_AI=false

# Stripe (billing) — use test-mode keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
